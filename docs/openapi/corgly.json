    "/pets/upload-photo": {
      "post": {
        "summary": "Upload a pet PNG photograph",
        "description": "Upload a pet PNG photograph. Uses the documented sandbox bearer token; no real provider side effects. See README for sample prerequisites.",
        "operationId": "uploadPhoto",
        "tags": [
          "Pets"
        ],
        "parameters": [
          {
            "name": "X-Sandbox-Failure",
            "in": "header",
            "required": false,
            "description": "LOCAL SANDBOX ONLY: force a documented error to exercise clients.",
            "schema": {
              "type": "string",
              "enum": [
                "403",
                "500",
                "503"
              ]
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/PhotoRequest"
              },
              "example": {
                "pet_id": "corgi_98231",
                "photo": "assets/einstein.png"
              },
              "encoding": {
                "photo": {
                  "contentType": "image/png"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful operation.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PhotoResponse"
                },
                "example": {
                  "pet_id": "corgi_98231",
                  "photo_id": "photo_0001",
                  "filename": "einstein.png",
                  "bytes_received": 68
                }
              }
            }
          },
          "400": {
            "description": "Malformed or invalid request.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
