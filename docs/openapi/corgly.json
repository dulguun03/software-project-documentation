  "components": {
    "securitySchemes": {
      "SandboxBearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "Opaque sandbox token: sprint05-local-sandbox. Not a JWT. Production requires a verified app session; provider OAuth tokens remain server-side."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "user_message",
          "correlation_id",
          "error"
        ],
        "properties": {
          "status": {
            "type": "string",
            "example": "succeeded"
          },
          "user_message": {
            "type": "string",
            "example": "Sandbox operation completed."
          },
          "correlation_id": {
            "type": "string",
            "example": "corr_sandbox_0001"
          },
          "error": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string",
                "example": "invalid_request"
              },
              "message": {
                "type": "string",
                "example": "Review the request fields."
              }
            }
          }
        }
      },
      "PhotoRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "pet_id",
          "photo"
        ],
        "properties": {
          "pet_id": {
            "type": "string",
            "example": "corgi_98231"
          },
          "photo": {
            "type": "string",
            "format": "binary",
            "description": "PNG file, e.g. assets/einstein.png."
          }
        },
        "example": {
          "pet_id": "corgi_98231",
          "photo": "assets/einstein.png"
        }
      },
      "AudioRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "pet_id",
          "audio"
        ],
        "properties": {
          "pet_id": {
            "type": "string",
            "example": "corgi_98231"
          },
          "audio": {
            "type": "string",
            "format": "binary",
            "description": "WAV file, e.g. assets/einstein-bark.wav."
          }
        },
        "example": {
          "pet_id": "corgi_98231",
          "audio": "assets/einstein-bark.wav"
        }
      },
      "SubscriptionRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "pet_id",
          "callback_url",
          "events"
        ],
        "properties": {
          "pet_id": {
            "type": "string",
            "example": "corgi_98231"
          },
          "callback_url": {
            "type": "string",
            "example": "https://example.org/corgly/pet-activity",
            "format": "uri"
          },
          "events": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "enum": [
                "pet.activity.detected"
              ]
            }
          }
        },
        "example": {
          "pet_id": "corgi_98231",
          "callback_url": "https://example.org/corgly/pet-activity",
          "events": [
            "pet.activity.detected"
          ]
        }
      },
      "PhotoResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "pet_id",
          "photo_id",
          "filename",
          "bytes_received"
        ],
        "properties": {
          "pet_id": {
            "type": "string",
            "example": "corgi_98231"
          },
          "photo_id": {
            "type": "string",
            "example": "photo_0001"
          },
          "filename": {
